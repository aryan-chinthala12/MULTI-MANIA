<Window x:Class="MultiBtOut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiBtOut.ViewModels"
        Title="MultiBtOut — mirror system audio to multiple Bluetooth sinks"
        Height="680" Width="760" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh devices" Command="{Binding RefreshCommand}"
                    Padding="12,5" Margin="0,0,8,0" MinWidth="110" />
            <Button Content="Start mirroring" Command="{Binding StartCommand}"
                    Padding="12,5" Margin="0,0,8,0" MinWidth="120" FontWeight="SemiBold" />
            <Button Content="Stop" Command="{Binding StopCommand}"
                    Padding="12,5" MinWidth="70" />
            <TextBlock Text="{Binding SelectionHint}" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="Gray" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Device checklist -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Devices}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalContentAlignment="Center" Margin="2,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Details}" Foreground="Gray" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="Per-device volume (stream level, 0–100 %)"
                   FontWeight="SemiBold" Margin="0,10,0,4" />

        <!-- Per-device volume -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Devices}" Background="Transparent"
                 BorderThickness="0" Padding="0"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0,2" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                Value="{Binding VolumePercent, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0}%}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="Health &amp; log"
                   FontWeight="SemiBold" Margin="0,10,0,4" />

        <!-- Health + log -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="70" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <ListBox Grid.Row="0" ItemsSource="{Binding HealthLines}"
                     FontFamily="Consolas" FontSize="11" BorderThickness="0,0,0,1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <TextBox Grid.Row="1" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                     Background="#FAFAFA" Margin="0,4,0,0" />
        </Grid>
    </Grid>
</Window>
