<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MultiBtOut</RootNamespace>
    <AssemblyName>MultiBtOut</AssemblyName>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Build with any modern SDK (e.g. .NET 10) but let the app launch on the newest
         installed WindowsDesktop runtime when the exact net8.0 one is absent. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio 2.2.1: WasapiLoopbackCapture / WasapiOut / MMDeviceEnumerator -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
